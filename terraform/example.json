{
  "region": "us-east-2",
  "aws_profile": "default",
  "assume_role_arn": "",

  "env": "dev",
  "project_name": "s3keepass",

  "console": true,
  "function_url_auth": "NONE",
  "console_auth_username": "frank",
  "console_auth_password": "CHANGE-ME",

  "bucket": "s3keepass-dev-change-me",
  "keep_versions": 100,
  "log_retention_days": 90,
  "template_source": "env",
  "template": {
    "kdf": { "memory_mib": 128, "parallelism": 2, "unlock_ms": 1500 },
    "cipher": "aes256",
    "groups": [],
    "fields": [],
    "history_max_items": 0,
    "recycle_bin": false
  },
  "force_destroy": false,
  "architecture": "arm64"
}
